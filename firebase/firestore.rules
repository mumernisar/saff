rules_version = '2';

// docs/SECURITY.md section 2. Server-written data (`[S]` in DATA_MODEL.md) is never client-writable.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function saffDoc(saffId) { return get(/databases/$(database)/documents/saffs/$(saffId)); }
    function member(saffId) {
      return signedIn() && request.auth.uid in saffDoc(saffId).data.memberIds;
    }
    function sharesSaff(uid) {
      return signedIn()
        && userDoc(uid).data.saffIds.hasAny(userDoc(request.auth.uid).data.saffIds);
    }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function roundDoc(saffId, rid) {
      return get(/databases/$(database)/documents/saffs/$(saffId)/rounds/$(rid));
    }

    // Written only by capBilling (Admin SDK); every signed-in user may read it.
    match /config/backend {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || sharesSaff(uid));
      allow update: if request.auth.uid == uid
        && changes(['settings', 'appVersion', 'platform', 'oem', 'androidSdk', 'lastActiveAt', 'learning']);
      allow create, delete: if false;

      match /private/{doc} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
      match /devices/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /entitlement/{doc} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
      match /stats/{doc} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
      match /badges/{id} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
      match /lessons/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /learning/{id} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /imports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'uploaded'
        && request.resource.data.saffId is string
        && request.resource.data.fileName is string;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if false;
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /saffs/{saffId} {
      allow read: if member(saffId);
      allow update: if member(saffId) && changes(['whatsappGroupLink'])
        && (request.resource.data.whatsappGroupLink == null
            || request.resource.data.whatsappGroupLink.matches('^https://chat\\.whatsapp\\.com/.+'));
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if member(saffId);
        allow update: if request.auth.uid == uid && member(saffId) && changes(['presence']);
        allow create, delete: if false;
      }

      match /alarms/{id} {
        allow read: if member(saffId);
        allow write: if false;
      }

      match /proposals/{id} {
        allow read: if member(saffId);
        allow write: if false;
        match /votes/{uid} {
          allow read: if member(saffId);
          allow write: if false;
        }
      }

      match /messages/{id} {
        allow read: if member(saffId);
        allow create: if member(saffId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if member(saffId)
          && (changes(['seenBy'])
              || (resource.data.authorId == request.auth.uid
                  && changes(['deletedAt'])
                  && request.time < resource.data.createdAt + duration.value(1, 'h')));
        allow delete: if false;
      }

      match /occurrences/{id} {
        allow read: if member(saffId);
        allow write: if false;
        match /skips/{uid} {
          allow read: if member(saffId);
          allow write: if false;
        }
        match /plants/{pid} {
          allow read: if member(saffId) && resource.data.authorId == request.auth.uid;
          allow write: if false;
        }
      }

      match /rounds/{rid} {
        allow read: if member(saffId);
        allow write: if false;

        match /results/{uid} {
          allow create: if member(saffId) && request.auth.uid == uid
            && roundDoc(saffId, rid).data.status == 'locked'
            && request.time < roundDoc(saffId, rid).data.deadlineAt;
          allow read: if request.auth.uid == uid
            || (member(saffId) && roundDoc(saffId, rid).data.status == 'revealed');
          allow update, delete: if false;
        }
        match /grades/{uid} {
          allow read: if request.auth.uid == uid
            || (member(saffId) && roundDoc(saffId, rid).data.status == 'revealed');
          allow write: if false;
        }
        match /reveal/{doc} {
          allow read: if member(saffId);
          allow write: if false;
        }
        match /presence/{uid} {
          allow read: if member(saffId);
          allow create, update: if request.auth.uid == uid && member(saffId)
            && request.resource.data.status in ['asleep', 'snoozed', 'playing', 'done']
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
        match /askMeGrades/{id} {
          allow read: if member(saffId);
          allow write: if false;
        }
        match /nudges/{id} {
          allow read: if member(saffId);
          allow write: if false;
        }
        match /selfies/{uid} {
          allow read: if member(saffId);
          allow create: if request.auth.uid == uid && member(saffId)
            && roundDoc(saffId, rid).data.status == 'locked'
            && roundDoc(saffId, rid).data.mode == 'selfie';
          allow update, delete: if false;
        }
      }

      match /stats/{doc=**} {
        allow read: if member(saffId);
        allow write: if false;
      }
      match /packs/{doc=**} {
        allow read: if member(saffId);
        allow write: if false;
      }
      match /seenCards/{doc} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
